# Stage 1: Build static Go binary
FROM golang:alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git

# Copy dependencies definitions
COPY backend/go.mod backend/go.sum* ./

# Fetch dependencies
RUN go mod download

# Copy backend source code
COPY backend/ ./

# Build statically linked binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/updater cmd/updater/main.go

# Stage 2: Final lightweight runner
FROM alpine:3.19

WORKDIR /app

# Install docker CLI, git, and certificates
RUN apk add --no-cache docker-cli git ca-certificates tzdata

# Create data directories and manifests paths
RUN mkdir -p /app/data /app/manifests /app/gitops

# Copy built executable
COPY --from=builder /app/updater /app/updater

# Expose API port
EXPOSE 8080

# Run daemon
ENTRYPOINT ["/app/updater"]
